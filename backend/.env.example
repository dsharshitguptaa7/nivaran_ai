# DATABASE CONFIGURATION
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/nivaran_ai_database

# SECURITY / JWT AUTHENTICATION
SECRET_KEY=your-secure-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS CONFIGURATION (Comma-separated origins for dev/LAN/prod)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# FILE STORAGE CONFIGURATION (Optional: defaults to backend/storage/documents)
STORAGE_DIR=

# EMAIL / SMTP CONFIGURATION
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=noreply@nivaran.ac.in
SMTP_FROM_NAME=NIVARAN-AI
SMTP_FROM=NIVARAN-AI <noreply@nivaran.ac.in>

# FRONTEND APPLICATION URL
FRONTEND_URL=http://localhost:5173

